@model List<WebApplication5.Models.Card>
@{
    ViewBag.Title = "Рыбацкие удочки";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="products-header">
    <h1>Рыбацкие удочки</h1>
    <p>Широкий выбор качественных удочек для профессиональной и любительской рыбалки</p>
</div>

<div id="productsContainer" class="products-grid">
    <!-- Товары будут загружены через JavaScript -->
    <div class="loading">Загрузка товаров...</div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        loadProducts();
    });

    function loadProducts() {
        fetch('https://localhost:7276/api/Tovars')
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json();
            })
            .then(tovars => {
                console.log('Received products:', tovars);
                displayProducts(tovars);
            })
            .catch(error => {
                console.error('Error loading products:', error);
                document.getElementById('productsContainer').innerHTML =
                    '<div class="error">Ошибка загрузки товаров: ' + error.message + '</div>';
            });
    }

    function displayProducts(tovars) {
        const container = document.getElementById('productsContainer');

        if (!tovars || tovars.length === 0) {
            container.innerHTML = '<div class="no-products">Товары не найдены</div>';
            return;
        }

        const productsHTML = tovars.map(tovar => `
            <div class="product-card" onclick="location.href='/Products/Card/${tovar.id}'">
                <div class="product-image">
                    <img src="${tovar.image || 'https://via.placeholder.com/300x200?text=No+Image'}" alt="${tovar.title}"
                         onerror="this.src='https://via.placeholder.com/300x200?text=No+Image'" />
                    ${tovar.count > 0 ?
                '<div class="stock-badge in-stock">В наличии</div>' :
                '<div class="stock-badge out-of-stock">Нет в наличии</div>'
            }
                </div>
                <div class="product-info">
                    <h3 class="product-name">${tovar.title}</h3>
                    <p class="product-description">${tovar.description || 'Описание отсутствует'}</p>
                    <div class="product-category">Рыбацкие удочки</div>
                    <div class="product-price">${parseInt(tovar.price).toLocaleString('ru-RU')} руб</div>
                    <div class="product-stock">
                        ${tovar.count > 0 ?
                `<span class="stock-text">Осталось: ${tovar.count} шт.</span>` :
                `<span class="stock-text out-of-stock-text">Нет в наличии</span>`
            }
                    </div>
                </div>
            </div>
        `).join('');

        container.innerHTML = productsHTML;
    }
</script>

<style>
    .products-header {
        text-align: center;
        margin-bottom: 40px;
        padding: 20px 0;
    }

        .products-header h1 {
            color: #2c3e50;
            margin-bottom: 10px;
            font-size: 32px;
        }

        .products-header p {
            color: #666;
            font-size: 16px;
            max-width: 600px;
            margin: 0 auto;
        }

    .loading, .error, .no-products {
        text-align: center;
        padding: 40px;
        font-size: 18px;
        color: #666;
        grid-column: 1 / -1;
    }

    .error {
        color: #dc3545;
        background: #f8d7da;
        border-radius: 8px;
    }

    .products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 30px;
        padding: 20px 0;
    }

    .product-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        transition: all 0.3s ease;
        cursor: pointer;
        overflow: hidden;
        border: 1px solid #e9ecef;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        }

    .product-image {
        position: relative;
        height: 200px;
        overflow: hidden;
    }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

    .product-card:hover .product-image img {
        transform: scale(1.05);
    }

    .stock-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: bold;
        text-transform: uppercase;
    }

    .in-stock {
        background: #28a745;
        color: white;
    }

    .out-of-stock {
        background: #dc3545;
        color: white;
    }

    .product-info {
        padding: 20px;
    }

    .product-name {
        color: #2c3e50;
        margin: 0 0 10px 0;
        font-size: 18px;
        font-weight: bold;
        line-height: 1.3;
    }

    .product-description {
        color: #666;
        font-size: 14px;
        line-height: 1.5;
        margin-bottom: 15px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .product-category {
        display: inline-block;
        background: #e9ecef;
        color: #495057;
        padding: 4px 12px;
        border-radius: 15px;
        font-size: 12px;
        margin-bottom: 15px;
    }

    .product-price {
        font-size: 20px;
        font-weight: bold;
        color: #007bff;
        margin-bottom: 8px;
    }

    .product-stock {
        font-size: 14px;
    }

    .stock-text {
        color: #28a745;
        font-weight: 500;
    }

    .out-of-stock-text {
        color: #dc3545;
    }
</style>