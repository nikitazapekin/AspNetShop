@model List<WebApplication5.Models.Card>
@{
    ViewBag.Title = "Рыбацкие удочки";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="products-header">
    <h1>Рыбацкие удочки</h1>
    <p>Широкий выбор качественных удочек для профессиональной и любительской рыбалки</p>
</div>

<div class="products-grid">
    @foreach (var card in Model)
    {
        <div class="product-card" onclick="location.href='@Url.Action("Card", "Products", new { id = card.Id })'">
            <div class="product-image">
                <img src="@card.ImageUrl" alt="@card.Name" />
               
            </div>
            <div class="product-info">
                <h3 class="product-name">@card.Name</h3>
                <p class="product-description">@card.Description</p>
                <div class="product-category">@card.Category</div>
                <div class="product-price">@card.Price.ToString("N0") руб</div>
                <div class="product-stock">
                    @if (card.StockQuantity > 0)
                    {
                        <span class="stock-text">Осталось: @card.StockQuantity шт.</span>
                    }
                    else
                    {
                        <span class="stock-text out-of-stock-text">Нет в наличии</span>
                    }
                </div>
            </div>
        </div>
    }
</div>

<style>
    .products-header {
        text-align: center;
        margin-bottom: 40px;
        padding: 20px 0;
    }

        .products-header h1 {
            color: #2c3e50;
            margin-bottom: 10px;
            font-size: 32px;
        }

        .products-header p {
            color: #666;
            font-size: 16px;
            max-width: 600px;
            margin: 0 auto;
        }

    .products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 30px;
        padding: 20px 0;
    }

    .product-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        transition: all 0.3s ease;
        cursor: pointer;
        overflow: hidden;
        border: 1px solid #e9ecef;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        }

    .product-image {
        position: relative;
        height: 200px;
        overflow: hidden;
    }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

    .product-card:hover .product-image img {
        transform: scale(1.05);
    }

    .stock-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: bold;
        text-transform: uppercase;
    }

    .in-stock {
        background: #28a745;
        color: white;
    }

    .out-of-stock {
        background: #dc3545;
        color: white;
    }

    .product-info {
        padding: 20px;
    }

    .product-name {
        color: #2c3e50;
        margin: 0 0 10px 0;
        font-size: 18px;
        font-weight: bold;
        line-height: 1.3;
    }

    .product-description {
        color: #666;
        font-size: 14px;
        line-height: 1.5;
        margin-bottom: 15px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .product-category {
        display: inline-block;
        background: #e9ecef;
        color: #495057;
        padding: 4px 12px;
        border-radius: 15px;
        font-size: 12px;
        margin-bottom: 15px;
    }

    .product-price {
        font-size: 20px;
        font-weight: bold;
        color: #007bff;
        margin-bottom: 8px;
    }

    .product-stock {
        font-size: 14px;
    }

    .stock-text {
        color: #28a745;
        font-weight: 500;
    }

    .out-of-stock-text {
        color: #dc3545;
    }

 
</style>