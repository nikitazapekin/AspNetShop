@model List<WebApplication5.Models.Card>
@{
    ViewBag.Title = "Рыбацкие удочки";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="products-header">
    <h1>Рыбацкие удочки</h1>
    <p>Широкий выбор качественных удочек для профессиональной и любительской рыбалки</p>
</div>
 
<div class="search-container">
    <div class="search-box">
        <input type="text"
               id="searchInput"
               placeholder="Поиск удочек по названию..."
               class="search-input" />
       
    </div>
    <div class="search-info" id="searchInfo"></div>
</div>

<div id="productsContainer" class="products-grid">
    
    <div class="loading">Загрузка товаров...</div>
</div>

<script>
  
    let searchTimeout;
    let currentSearchQuery = '';

    document.addEventListener('DOMContentLoaded', function () {
        loadProducts();
        setupSearch();
    });

    function setupSearch() {
        const searchInput = document.getElementById('searchInput');

        searchInput.addEventListener('input', function (e) {
            const query = e.target.value.trim();
            currentSearchQuery = query;

         
            clearTimeout(searchTimeout);

          
            const searchInfo = document.getElementById('searchInfo');
            if (query) {
                searchInfo.textContent = `Поиск: "${query}"`;
                searchInfo.style.display = 'block';
                searchInfo.style.whiteSpace ='nowrap'
            } else {
                searchInfo.style.display = 'none';
            }

          
            searchTimeout = setTimeout(() => {
                loadProducts(query);
            }, 500);
        });

       
        searchInput.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                e.target.value = '';
                currentSearchQuery = '';
                document.getElementById('searchInfo').style.display = 'none';
                loadProducts();
            }
        });
    }

    function loadProducts(searchQuery = '') {
      
        const container = document.getElementById('productsContainer');
        container.innerHTML = '<div class="loading">Загрузка товаров...</div>';

       
        let url = 'https://localhost:7276/api/Tovars';
        if (searchQuery) {
            url += `?search=${encodeURIComponent(searchQuery)}`;
        }

        fetch(url)
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json();
            })
            .then(tovars => {
                console.log('Received products:', tovars);
                displayProducts(tovars, searchQuery);
            })
            .catch(error => {
                console.error('Error loading products:', error);
                container.innerHTML =
                    '<div class="error">Ошибка загрузки товаров: ' + error.message + '</div>';
            });
    }

    function displayProducts(tovars, searchQuery = '') {
        const container = document.getElementById('productsContainer');

        if (!tovars || tovars.length === 0) {
            if (searchQuery) {
                container.innerHTML = `
                    <div class="no-products">
                        <h3>По запросу "${searchQuery}" ничего не найдено</h3>
                        <p>Попробуйте изменить поисковый запрос</p>
                        <button class="btn-clear-search" onclick="clearSearch()">Показать все товары</button>
                    </div>
                `;
            } else {
                container.innerHTML = '<div class="no-products">Товары не найдены</div>';
            }
            return;
        }

        const productsHTML = tovars.map(tovar => `
            <div class="product-card" onclick="location.href='/Products/Card/${tovar.id}'">
                <div class="product-image">
                    <img src="${tovar.image || 'https://via.placeholder.com/300x200?text=No+Image'}" alt="${tovar.title}"
                       />
                    ${tovar.count > 0 ?
                '<div class="stock-badge in-stock">В наличии</div>' :
                '<div class="stock-badge out-of-stock">Нет в наличии</div>'
            }
                </div>
                <div class="product-info">
                    <h3 class="product-name">${tovar.title}</h3>
                    <p class="product-description">${tovar.description || 'Описание отсутствует'}</p>
                    <div class="product-category">Рыбацкие удочки</div>
                    <div class="product-price">${parseInt(tovar.price).toLocaleString('ru-RU')} руб</div>
                    <div class="product-stock">
                        ${tovar.count > 0 ?
                `<span class="stock-text">Осталось: ${tovar.count} шт.</span>` :
                `<span class="stock-text out-of-stock-text">Нет в наличии</span>`
            }
                    </div>
                </div>
            </div>
        `).join('');

       
        const resultsInfo = searchQuery ?
            `<div class="search-results-info">Найдено товаров: ${tovars.length}</div>` :
            '';

        container.innerHTML = resultsInfo + productsHTML;
    }

    function clearSearch() {
        const searchInput = document.getElementById('searchInput');
        searchInput.value = '';
        currentSearchQuery = '';
        document.getElementById('searchInfo').style.display = 'none';
        loadProducts();
    }
</script>

<style>
    .products-header {
        text-align: center;
        margin-bottom: 40px;
        padding: 20px 0;
    }

        .products-header h1 {
            color: #2c3e50;
            margin-bottom: 10px;
            font-size: 32px;
        }

        .products-header p {
            color: #666;
            font-size: 16px;
            max-width: 600px;
            margin: 0 auto;
        }

    .search-container {
       width: 600px;
        margin: 0 auto 40px auto;
        padding: 0 20px;
        display: flex; 
        justify-content: center;
    }

    .search-box {
        position: relative;
        margin-bottom: 10px;
        width: 100%;
        display: flex;
        justify-content: center;
    }

    .search-input {
        width: 100%;
        padding: 15px 50px 15px 20px;
        border: 2px solid #e9ecef;
        border-radius: 30px;
        font-size: 16px;
        transition: all 0.3s ease;
        box-sizing: border-box;
    }

        .search-input:focus {
            outline: none;
            border-color: #007bff;
            box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.1);
        }

        .search-input::placeholder {
            color: #999;
        }

    .search-icon {
        position: absolute;
        right: 20px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 18px;
        color: #666;
        pointer-events: none;
    }

    .search-info {
        text-align: center;
        color: #666;
        font-size: 14px;
        margin-top: 10px;
        display: none;
    }

    .search-results-info {
        grid-column: 1 / -1;
        text-align: center;
        color: #666;
        font-size: 16px;
        margin-bottom: 20px;
        padding: 10px;
        background: #f8f9fa;
        border-radius: 8px;
    }

    .loading, .error, .no-products {
        text-align: center;
        padding: 40px;
        font-size: 18px;
        color: #666;
        grid-column: 1 / -1;
    }

    .error {
        color: #dc3545;
        background: #f8d7da;
        border-radius: 8px;
    }

    .no-products {
        padding: 60px 20px;
    }

        .no-products h3 {
            margin-bottom: 10px;
            color: #2c3e50;
        }

        .no-products p {
            margin-bottom: 20px;
            color: #666;
        }

    .btn-clear-search {
        background: #007bff;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 14px;
        transition: background 0.3s;
    }

        .btn-clear-search:hover {
            background: #0056b3;
        }

    .products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 30px;
        padding: 20px 0;
    }

    .product-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        transition: all 0.3s ease;
        cursor: pointer;
        overflow: hidden;
        border: 1px solid #e9ecef;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        }

    .product-image {
        position: relative;
        height: 200px;
        overflow: hidden;
    }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

    .product-card:hover .product-image img {
        transform: scale(1.05);
    }

    .stock-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: bold;
        text-transform: uppercase;
    }

    .in-stock {
        background: #28a745;
        color: white;
    }

    .out-of-stock {
        background: #dc3545;
        color: white;
    }

    .product-info {
        padding: 20px;
    }

    .product-name {
        color: #2c3e50;
        margin: 0 0 10px 0;
        font-size: 18px;
        font-weight: bold;
        line-height: 1.3;
    }

    .product-description {
        color: #666;
        font-size: 14px;
        line-height: 1.5;
        margin-bottom: 15px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .product-category {
        display: inline-block;
        background: #e9ecef;
        color: #495057;
        padding: 4px 12px;
        border-radius: 15px;
        font-size: 12px;
        margin-bottom: 15px;
    }

    .product-price {
        font-size: 20px;
        font-weight: bold;
        color: #007bff;
        margin-bottom: 8px;
    }

    .product-stock {
        font-size: 14px;
    }

    .stock-text {
        color: #28a745;
        font-weight: 500;
    }

    .out-of-stock-text {
        color: #dc3545;
    }

   
</style>