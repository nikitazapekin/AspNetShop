@model WebApplication5.Models.Card
@{
    ViewBag.Title = Model.Name;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card-detail">
    <div class="card-detail-content">
        <div class="card-image">
            <img src="@Model.ImageUrl" alt="@Model.Name" />
        </div>
        <div class="card-info">
            <h1>@Model.Name</h1>
            <div class="card-category">@Model.Category</div>
            <div class="card-price">@Model.Price.ToString() Руб</div>
            <div class="card-stock">
                @if (Model.StockQuantity > 0)
                {
                    <span class="in-stock">В наличии: @Model.StockQuantity шт.</span>
                }
                else
                {
                    <span class="out-of-stock"> Нет в наличии</span>
                }
            </div>
            <div class="card-description">
                <h3>Описание</h3>
                <p>@Model.Description</p>
            </div>
            <div class="card-actions">
                <button class="btn-add-to-cart">Добавить в корзину</button>
                <button class="btn-back" onclick="history.back()">Назад к каталогу</button>
            </div>
        </div>
    </div>
</div>

<style>
    .card-detail {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    .card-detail-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        background: white;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .card-image img {
        width: 100%;
        height: 400px;
        object-fit: cover;
        border-radius: 8px;
    }

    .card-info h1 {
        color: #2c3e50;
        margin-bottom: 10px;
        font-size: 28px;
    }

    .card-category {
        display: inline-block;
        background: #007bff;
        color: white;
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 14px;
        margin-bottom: 20px;
    }

    .card-price {
        font-size: 32px;
        font-weight: bold;
        color: #007bff;
        margin-bottom: 15px;
    }

    .card-stock {
        font-size: 16px;
        margin-bottom: 25px;
        padding: 10px 0;
    }

    .in-stock {
        color: #28a745;
        font-weight: 500;
    }

    .out-of-stock {
        color: #dc3545;
        font-weight: 500;
    }

    .card-description h3 {
        color: #2c3e50;
        margin-bottom: 10px;
        font-size: 20px;
    }

    .card-description p {
        color: #666;
        line-height: 1.6;
        font-size: 16px;
    }

    .card-actions {
        margin-top: 30px;
        display: flex;
        gap: 15px;
    }

    .btn-add-to-cart {
        background: #007bff;
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 6px;
        font-size: 16px;
        cursor: pointer;
        transition: background 0.3s;
    }

        .btn-add-to-cart:hover {
            background: #0056b3;
        }

    .btn-back {
        background: #6c757d;
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 6px;
        font-size: 16px;
        cursor: pointer;
        transition: background 0.3s;
    }

        .btn-back:hover {
            background: #545b62;
        }
 
</style>