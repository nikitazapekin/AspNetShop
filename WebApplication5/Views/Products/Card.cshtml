@{
    ViewBag.Title = "Карточка товара";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card-detail">
    <div class="card-detail-content">
        <div id="loadingMessage">Загрузка товара...</div>
        <div id="errorMessage" style="display: none;"></div>

        <div id="productContent" style="display: none;">
            <div class="card-image">
                <img id="productImage" src="" alt="" />
            </div>
            <div class="card-info">
                <h1 id="productName"></h1>
                <div class="card-category" id="productCategory"></div>
                <div class="card-price" id="productPrice"></div>
                <div class="card-stock" id="productStock"></div>
                <div class="card-description">
                    <h3>Описание</h3>
                    <p id="productDescription"></p>
                </div>
                <div class="card-actions">
                    <div class="quantity-selector">
                        <label>Количество:</label>
                        <div class="quantity-controls">
                            <button class="quantity-btn minus-btn" id="decreaseQuantity">-</button>
                            <input type="number" class="quantity-input" id="productQuantity" value="1" min="1">
                            <button class="quantity-btn plus-btn" id="increaseQuantity">+</button>
                        </div>
                    </div>
                    <button class="btn-add-to-cart" id="addToCartBtn">Добавить в корзину</button>
                    <button class="btn-back" onclick="history.back()">Назад к каталогу</button>
                </div>
            </div>
        </div>
    </div>
</div>
 
<div id="quantityErrorModal" class="modal">
    <div class="modal-content">
        <span class="close" onclick="closeQuantityErrorModal()">&times;</span>
        <h2>Ошибка количества</h2>
        <div id="quantityErrorText"></div>
        <div class="modal-buttons">
            <button type="button" class="btn btn-primary" onclick="closeQuantityErrorModal()">OK</button>
        </div>
    </div>
</div>

<script>
    let isAddingToCart = false;
    let currentProduct = null;
    let currentQuantity = 1;

    document.addEventListener('DOMContentLoaded', function () {
        loadProduct();
 
        document.getElementById('decreaseQuantity').addEventListener('click', decreaseQuantity);
        document.getElementById('increaseQuantity').addEventListener('click', increaseQuantity);
        document.getElementById('productQuantity').addEventListener('change', handleQuantityInput);
    });

    function getProductIdFromUrl() {
        const path = window.location.pathname;
        const segments = path.split('/');
        return segments[segments.length - 1];
    }

    function loadProduct() {
        const productId = getProductIdFromUrl();

        if (!productId || isNaN(productId)) {
            showError('Неверный ID товара');
            return;
        }

        fetch(`https://localhost:7276/api/Tovars/${productId}`)
            .then(response => {
                if (!response.ok) {
                    throw new Error('Товар не найден');
                }
                return response.json();
            })
            .then(product => {
                console.log('Received product:', product);
                currentProduct = product;
                displayProduct(product);
            })
            .catch(error => {
                console.error('Error loading product:', error);
                showError('Ошибка загрузки товара: ' + error.message);
            });
    }

    function displayProduct(product) {
        document.getElementById('loadingMessage').style.display = 'none';

        document.getElementById('productName').textContent = product.title || 'Название не указано';
        document.getElementById('productCategory').textContent = 'Рыбацкие удочки';
        document.getElementById('productPrice').textContent = (product.price ? parseInt(product.price).toLocaleString('ru-RU') : '0') + ' Руб';
        document.getElementById('productDescription').textContent = product.description || 'Описание отсутствует';

        const productImage = document.getElementById('productImage');
        productImage.src = product.image || 'https://via.placeholder.com/500x400?text=No+Image';
        productImage.alt = product.title || 'Товар';

        productImage.onerror = function () {
            this.src = 'https://via.placeholder.com/500x400?text=No+Image';
        };

        const stockElement = document.getElementById('productStock');
        if (product.count > 0) {
            stockElement.innerHTML = '<span class="in-stock">В наличии: ' + product.count + ' шт.</span>';
            document.getElementById('addToCartBtn').disabled = false;
            document.getElementById('addToCartBtn').style.backgroundColor = '#007bff';

        
            document.getElementById('productQuantity').max = product.count;
        } else {
            stockElement.innerHTML = '<span class="out-of-stock">Нет в наличии</span>';
            document.getElementById('addToCartBtn').disabled = true;
            document.getElementById('addToCartBtn').style.backgroundColor = '#6c757d';
            document.getElementById('addToCartBtn').textContent = 'Нет в наличии';
            document.getElementById('productQuantity').disabled = true;
        }

        document.title = product.title + ' - Рыбацкие удочки';
        document.getElementById('productContent').style.display = 'grid';
    }

    function decreaseQuantity() {
        const quantityInput = document.getElementById('productQuantity');
        let quantity = parseInt(quantityInput.value);
        if (quantity > 1) {
            quantity--;
            quantityInput.value = quantity;
            currentQuantity = quantity;
        }
    }

    function increaseQuantity() {
        const quantityInput = document.getElementById('productQuantity');
        let quantity = parseInt(quantityInput.value);
        const maxStock = currentProduct ? currentProduct.count : 1;

        if (quantity < maxStock) {
            quantity++;
            quantityInput.value = quantity;
            currentQuantity = quantity;
        } else {
            showQuantityErrorModal(`Максимальное доступное количество: ${maxStock} шт.`);
        }
    }

    function handleQuantityInput(event) {
        let quantity = parseInt(event.target.value);
        const maxStock = currentProduct ? currentProduct.count : 1;

        if (isNaN(quantity) || quantity < 1) {
            quantity = 1;
        }

        if (quantity > maxStock) {
            showQuantityErrorModal(`Максимальное доступное количество: ${maxStock} шт.`);
            quantity = maxStock;
        }

        event.target.value = quantity;
        currentQuantity = quantity;
    }

    function showError(message) {
        document.getElementById('loadingMessage').style.display = 'none';
        document.getElementById('errorMessage').style.display = 'block';
        document.getElementById('errorMessage').textContent = message;
        document.getElementById('errorMessage').style.color = '#dc3545';
        document.getElementById('errorMessage').style.padding = '20px';
        document.getElementById('errorMessage').style.textAlign = 'center';
        document.getElementById('errorMessage').style.fontSize = '18px';
    }

    document.getElementById('addToCartBtn').addEventListener('click', function () {
        if (isAddingToCart) {
            return;
        }

        const productId = getProductIdFromUrl();
        addToCart(productId, currentQuantity);
    });

    function addToCart(productId, quantity) {
        if (isAddingToCart) {
            return;
        }

        const accessToken = localStorage.getItem('accessToken');

        if (!accessToken) {
            alert('Для добавления товара в корзину необходимо авторизоваться');
            window.location.href = '/signin';
            return;
        }

        isAddingToCart = true;

        const addButton = document.getElementById('addToCartBtn');
        const originalText = addButton.textContent;
        addButton.textContent = 'Добавляем...';
        addButton.disabled = true;
        addButton.style.backgroundColor = '#6c757d';

        fetch('https://localhost:7276/api/Cart/add', {
            method: 'POST',
            headers: {
                'Authorization': 'Bearer ' + accessToken,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                tovarId: parseInt(productId),
                quantity: quantity
            })
        })
            .then(response => {
                if (!response.ok) {
                    if (response.status === 401) {
                        throw new Error('Неавторизованный доступ');
                    } else if (response.status === 400) {
                        return response.json().then(data => {
                            throw new Error(data.message || 'Товар не найден или недостаточно на складе');
                        });
                    }
                    throw new Error('Ошибка при добавлении в корзину');
                }
                return response.json();
            })
            .then(purchase => {
                console.log('Товар добавлен в корзину:', purchase);

                showSuccessMessage(`Товар успешно добавлен в корзину! (${quantity} шт.)`);

                updateStockAfterAdd(quantity);

                addButton.textContent = 'Добавлено в корзину';
                addButton.style.backgroundColor = '#28a745';
                addButton.disabled = true;
 
                document.getElementById('productQuantity').value = 1;
                currentQuantity = 1;

                setTimeout(() => {
                    resetAddButton();
                }, 3000);
            })
            .catch(error => {
                console.error('Error adding to cart:', error);

                if (error.message.includes('недостаточно') || error.message.includes('не найден')) {
                    showQuantityErrorModal('Не удалось добавить товар в корзину: ' + error.message);
                } else if (error.message.includes('Неавторизованный')) {
                    alert('Для добавления товара в корзину необходимо авторизоваться');
                    window.location.href = '/signin';
                } else {
                    showQuantityErrorModal('Ошибка при добавлении в корзину: ' + error.message);
                }

                resetAddButton();
            })
            .finally(() => {
                isAddingToCart = false;
            });
    }

    function resetAddButton() {
        const addButton = document.getElementById('addToCartBtn');
        addButton.textContent = 'Добавить в корзину';
        addButton.disabled = false;
        addButton.style.backgroundColor = '#007bff';
    }

    function updateStockAfterAdd(quantityAdded) {
        const stockElement = document.getElementById('productStock');
        const currentStockText = stockElement.textContent;
        const currentStockMatch = currentStockText.match(/В наличии: (\d+) шт\./);

        if (currentStockMatch) {
            const currentStock = parseInt(currentStockMatch[1]);
            const newStock = currentStock - quantityAdded;

            if (newStock > 0) {
                stockElement.innerHTML = '<span class="in-stock">В наличии: ' + newStock + ' шт.</span>';
                
                document.getElementById('productQuantity').max = newStock;
              
                if (currentProduct) {
                    currentProduct.count = newStock;
                }
            } else {
                stockElement.innerHTML = '<span class="out-of-stock">Нет в наличии</span>';
                document.getElementById('addToCartBtn').disabled = true;
                document.getElementById('addToCartBtn').style.backgroundColor = '#6c757d';
                document.getElementById('addToCartBtn').textContent = 'Нет в наличии';
                document.getElementById('productQuantity').disabled = true;
            }
        }
    }

    function showSuccessMessage(message) {
        let notification = document.getElementById('successNotification');
        if (!notification) {
            notification = document.createElement('div');
            notification.id = 'successNotification';
            notification.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                background: #28a745;
                color: white;
                padding: 15px 20px;
                border-radius: 6px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.2);
                z-index: 1000;
                font-weight: 500;
                max-width: 300px;
            `;
            document.body.appendChild(notification);
        }

        notification.textContent = message;
        notification.style.display = 'block';

        setTimeout(() => {
            notification.style.display = 'none';
        }, 3000);
    }

    function showQuantityErrorModal(message) {
        document.getElementById('quantityErrorText').textContent = message;
        document.getElementById('quantityErrorModal').style.display = 'block';
    }

    function closeQuantityErrorModal() {
        document.getElementById('quantityErrorModal').style.display = 'none';
    }
 
    window.addEventListener('click', function (event) {
        const modal = document.getElementById('quantityErrorModal');
        if (event.target === modal) {
            closeQuantityErrorModal();
        }
    });
</script>

<style>
    .card-detail {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    .card-detail-content {
        display: block;
        background: white;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        min-height: 500px;
    }

    #loadingMessage {
        text-align: center;
        padding: 40px;
        font-size: 18px;
        color: #666;
    }

    #productContent {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
    }

    .card-image img {
        width: 100%;
        height: 400px;
        object-fit: cover;
        border-radius: 8px;
    }

    .card-info h1 {
        color: #2c3e50;
        margin-bottom: 10px;
        font-size: 28px;
    }

    .card-category {
        display: inline-block;
        background: #007bff;
        color: white;
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 14px;
        margin-bottom: 20px;
    }

    .card-price {
        font-size: 32px;
        font-weight: bold;
        color: #007bff;
        margin-bottom: 15px;
    }

    .card-stock {
        font-size: 16px;
        margin-bottom: 25px;
        padding: 10px 0;
    }

    .in-stock {
        color: #28a745;
        font-weight: 500;
    }

    .out-of-stock {
        color: #dc3545;
        font-weight: 500;
    }

    .card-description h3 {
        color: #2c3e50;
        margin-bottom: 10px;
        font-size: 20px;
    }

    .card-description p {
        color: #666;
        line-height: 1.6;
        font-size: 16px;
    }

    .card-actions {
        margin-top: 30px;
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .quantity-selector {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 10px;
    }

        .quantity-selector label {
            font-weight: 500;
            color: #2c3e50;
            min-width: 100px;
        }

    .quantity-controls {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .quantity-btn {
        width: 35px;
        height: 35px;
        border: 2px solid #007bff;
        background: white;
        color: #007bff;
        border-radius: 50%;
        cursor: pointer;
        font-size: 16px;
        font-weight: bold;
        transition: all 0.3s;
    }

        .quantity-btn:hover {
            background: #007bff;
            color: white;
        }

        .quantity-btn:disabled {
            border-color: #ccc;
            color: #ccc;
            cursor: not-allowed;
        }

            .quantity-btn:disabled:hover {
                background: white;
                color: #ccc;
            }

    .quantity-input {
        width: 60px;
        height: 35px;
        border: 2px solid #e9ecef;
        border-radius: 6px;
        text-align: center;
        font-size: 16px;
    }

        .quantity-input:focus {
            outline: none;
            border-color: #007bff;
        }

    .btn-add-to-cart {
        background: #007bff;
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 6px;
        font-size: 16px;
        cursor: pointer;
        transition: background 0.3s;
    }

        .btn-add-to-cart:hover {
            background: #0056b3;
        }

        .btn-add-to-cart:disabled {
            background: #6c757d;
            cursor: not-allowed;
        }

    .btn-back {
        background: #6c757d;
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 6px;
        font-size: 16px;
        cursor: pointer;
        transition: background 0.3s;
    }

        .btn-back:hover {
            background: #545b62;
        }
 
    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.5);
    }

    .modal-content {
        background-color: white;
        margin: 10% auto;
        padding: 30px;
        border-radius: 12px;
        width: 90%;
        max-width: 500px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.3);
        position: relative;
    }

    .close {
        position: absolute;
        right: 20px;
        top: 15px;
        font-size: 28px;
        font-weight: bold;
        cursor: pointer;
        color: #aaa;
    }

        .close:hover {
            color: #000;
        }

    .modal-buttons {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 25px;
    }

    .btn {
        padding: 10px 20px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
    }

    .btn-primary {
        background: #007bff;
        color: white;
    }
</style>